# =============================================================================
# AgentDesk RAG Platform — Ortam Değişkenleri
# =============================================================================
# Bu dosyayı .env olarak kopyalayın ve kullandığınız sağlayıcıların değerlerini doldurun.
#
#   cp .env.example .env
#
# Yalnızca config.yaml'da seçtiğiniz sağlayıcıların değişkenlerini doldurmanız yeterlidir.
# Örneğin db_provider: neon ise sadece Neon bölümünü doldurun.
# =============================================================================

# =============================================================================
# LLM Sağlayıcıları
# =============================================================================
# config.yaml → llm.default_provider ile aktif sağlayıcıyı seçin.
# Yalnızca kullandığınız sağlayıcının API anahtarını doldurun.

# OpenAI (default_provider: openai)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (default_provider: anthropic)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google AI (default_provider: google)
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# vLLM — yerel LLM sunucusu (default_provider: vllm)
# docker compose --profile gpu up -d ile başlatılır
VLLM_BASE_URL=http://localhost:8080/v1

# Ollama — yerel LLM (default_provider: ollama)
# https://ollama.com → ollama serve ile başlatılır
# Varsayılan: http://localhost:11434/v1 (config.yaml'da tanımlı)

# =============================================================================
# Veritabanı Sağlayıcıları
# =============================================================================
# config.yaml → database.db_provider ile aktif sağlayıcıyı seçin:
#   postgresql : Self-hosted veya Docker PostgreSQL
#   neon       : Serverless bulut PostgreSQL (neon.tech) — ücretsiz plan mevcut
#   supabase   : Bulut PostgreSQL + BaaS (supabase.com) — ücretsiz plan mevcut
#
# ÖNEMLİ: db_provider değiştirdiğinizde config.yaml'daki mcp_servers bölümünde
# ilgili MCP sunucusunu enabled: true yapın ve diğerlerini false yapın.

# --- PostgreSQL (db_provider: postgresql) ---
# Docker Compose ile otomatik başlatılır veya mevcut bir PostgreSQL sunucusu kullanılır.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentdesk
POSTGRES_READONLY_USER=agentdesk_readonly
POSTGRES_READONLY_PASSWORD=
DB_PASSWORD=changeme

# --- Neon (db_provider: neon) ---
# 1. https://neon.tech adresinden ücretsiz hesap oluşturun
# 2. Yeni proje oluşturun
# 3. Dashboard > Connection Details > Connection string'i kopyalayın
# 4. Aşağıdaki değişkenleri doldurun
# 5. config.yaml'da: database.db_provider: "neon"
# 6. config.yaml'da: mcp_servers.neon_mcp.enabled: true, postgres_mcp.enabled: false
NEON_DATABASE_URL=
NEON_API_KEY=

# --- Supabase (db_provider: supabase) ---
# 1. https://supabase.com adresinden ücretsiz hesap oluşturun
# 2. Yeni proje oluşturun
# 3. Project Settings > Database > Connection string (Transaction pooler) kopyalayın
# 4. Project Settings > API > service_role key'i SUPABASE_ACCESS_TOKEN olarak kullanın
# 5. Project Settings > General > Reference ID'yi SUPABASE_PROJECT_REF olarak kullanın
# 6. config.yaml'da: database.db_provider: "supabase"
# 7. config.yaml'da: mcp_servers.supabase_mcp.enabled: true, postgres_mcp.enabled: false
SUPABASE_DATABASE_URL=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
